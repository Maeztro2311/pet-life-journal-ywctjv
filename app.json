
{
  "expo": {
    "name": "My Pets Diary",
    "slug": "my-pets-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/adbfa53a-69f2-4c1c-b2ce-510d44dbdaad.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/adbfa53a-69f2-4c1c-b2ce-510d44dbdaad.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.mypetsdiary",
      "icon": "./assets/images/adbfa53a-69f2-4c1c-b2ce-510d44dbdaad.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adbfa53a-69f2-4c1c-b2ce-510d44dbdaad.png",
        "backgroundColor": "#ffffff"
      },
      "icon": "./assets/images/adbfa53a-69f2-4c1c-b2ce-510d44dbdaad.png",
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.mypetsdiary"
    },
    "web": {
      "favicon": "./assets/images/adbfa53a-69f2-4c1c-b2ce-510d44dbdaad.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser"
    ],
    "scheme": "my-pets-diary",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
