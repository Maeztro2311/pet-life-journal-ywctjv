
{
  "expo": {
    "name": "MyPets",
    "slug": "mypets-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/503b02ae-e6d3-41ca-a80d-e9b0cca41c7c.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/503b02ae-e6d3-41ca-a80d-e9b0cca41c7c.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maeztro.id.MyPets",
      "icon": "./assets/images/503b02ae-e6d3-41ca-a80d-e9b0cca41c7c.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIStatusBarStyle": "UIStatusBarStyleDefault"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/503b02ae-e6d3-41ca-a80d-e9b0cca41c7c.png",
        "backgroundColor": "#ffffff"
      },
      "icon": "./assets/images/503b02ae-e6d3-41ca-a80d-e9b0cca41c7c.png",
      "package": "com.maeztro.id.MyPets",
      "softwareKeyboardLayoutMode": "adjustResize",
      "statusBarBackgroundColor": "#FFFACD",
      "statusBarStyle": "dark",
      "navigationBarColor": "#FFFFFF"
    },
    "web": {
      "favicon": "./assets/images/503b02ae-e6d3-41ca-a80d-e9b0cca41c7c.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser"
    ],
    "scheme": "my-pets-diary",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
